# AI Receptionist Demo — example env. Copy to .env and fill in.
# Order mirrors the Configuration table in README.md.

# Gemini brain. Required for LIVE mode; MOCK mode needs nothing here.
GEMINI_API_KEY=your-gemini-api-key

# Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Defaults to venues/northbridge-barbers.yaml.
VENUE_CONFIG_PATH=venues/northbridge-barbers.yaml

# mock (default) | twilio (stub in v1).
SMS_ADAPTER=mock

# Comma-sep. mock auto-included in MOCK mode.
NOTIFY_ADAPTER=mock,ghl,email

# json only in v1 (sqlite deferred).
STORE_ADAPTER=json

# Required when ghl in NOTIFY_ADAPTER.
GHL_API_KEY=your-gohighlevel-api-key
# Required when ghl in NOTIFY_ADAPTER.
GHL_LOCATION_ID=loc_abc...
# Optional; falls back to value in venue YAML.
GHL_PIPELINE_ID=pip_abc...
# Optional; falls back to venue YAML.
GHL_STAGE_ID=stg_abc...

# Required when email in NOTIFY_ADAPTER.
SMTP_HOST=smtp.gmail.com
SMTP_USER=user@example.com
SMTP_PASS=app-password-here
SMTP_FROM=receptionist@example.com
# Owner inbox for the demo.
SMTP_TO_OWNER=owner@example.com

# Only used by n8n workflow + ElevenLabs tools; not by the FastAPI app itself.
PUBLIC_BASE_URL=https://YOUR_PUBLIC_TUNNEL

# Monthly fee for the offer, used only by your own ROI worksheet (14-day audit
# -> 2x gate, see README "How this would be measured"). Nothing in the demo
# runtime reads this. Deliberately has no default: this repo publishes no price.
MONTHLY_FEE=
